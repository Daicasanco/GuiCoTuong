# Sao chép file này thành ".env" (cùng thư mục với server.js) rồi điền 1 trong các lựa chọn TURN bên dưới.
# Trên Render/hosting: khai báo các biến này trong mục Environment Variables, không cần file .env.
#
# TURN là máy chủ trung chuyển âm thanh/hình ảnh khi 2 người không kết nối thẳng được với nhau
# (rất hay gặp với 4G Viettel/Vina/Mobi, wifi công ty, trường học). Không có TURN thì voice giữa
# người chơi ở các mạng khác nhau có thể không nghe được.

# --- Lựa chọn 1: Cloudflare Realtime TURN (dash.cloudflare.com > Realtime > TURN Server) ---
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# --- Lựa chọn 2: Metered.ca (dashboard.metered.ca > TURN Server > API key) ---
# METERED_TURN_DOMAIN=tenapp.metered.live
# METERED_TURN_API_KEY=

# --- Lựa chọn 3: Tự dựng coturn trên VPS (khuyên dùng static-auth-secret) ---
# TURN_URLS=turn:turn.tenmien.vn:3478?transport=udp,turn:turn.tenmien.vn:3478?transport=tcp,turns:turn.tenmien.vn:443?transport=tcp
# TURN_SECRET=chuoi-bi-mat-trung-voi-static-auth-secret-cua-coturn
# Hoặc dùng tài khoản cố định (kém an toàn hơn):
# TURN_USERNAME=
# TURN_CREDENTIAL=
